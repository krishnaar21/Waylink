        </activity-alias>
        <activity-alias
            android:name=".Icon_classic_mint"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_app_classic_mint"
            android:roundIcon="@mipmap/ic_app_classic_mint"
