<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Weather only: the city name goes to Open-Meteo. Nothing else leaves the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Short taps of vibration on toggles and events, like the web app's navigator.vibrate. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Recording rides and saving where you parked, only when you ask. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Waylink">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- The app icon picker (Settings > Icons): one launcher entry per style, only the chosen one enabled. -->
        <activity-alias
            android:name=".Launcher"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_chrome"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_app_chrome"
            android:roundIcon="@mipmap/ic_app_chrome"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
